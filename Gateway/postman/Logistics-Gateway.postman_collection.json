        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const d = pm.response.json();",
              "pm.collectionVariables.set(\"user_id\", d.id);",
              "}"
            ]
          }
        }
      ]
