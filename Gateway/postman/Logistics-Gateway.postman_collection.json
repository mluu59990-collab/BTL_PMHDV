          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"khach_{{$guid}}\",\n  \"password\": \"Strong@123456\",\n  \"full_name\": \"Khách kiểm thử\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
