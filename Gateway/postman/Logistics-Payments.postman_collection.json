{
  "info": {
    "name": "Logistics — Thu hoàn phí vận chuyển",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ghi nhận giao dịch nhân viên đã thu/hoàn; không thực hiện chuyển tiền ngân hàng. Cấu hình admin_username/admin_password. Collection tạo khách, đơn và giao dịch thử trong DB đang kết nối; không tự xóa dữ liệu. Không dùng để thử trên dữ liệu kế toán thật."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "admin_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "payments_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "refund_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_code",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Đăng nhập ADMIN",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"payments_token\",pm.response.json().access_token);",
              "pm.collectionVariables.set(\"run_code\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Tạo khách thử",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/customers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{payments_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Khách test thu hoàn\",\n  \"phone\": \"0912345678\",\n  \"address\": \"Hà Nội\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"customer_id\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
