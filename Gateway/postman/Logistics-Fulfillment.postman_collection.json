{
  "info": {
    "name": "Logistics — Kho, kiện và vận chuyển",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cấu hình admin_username/admin_password. Collection tạo dữ liệu thử thật trên DB đang kết nối; không tự xóa khách/đơn/kiện. Các ID được lưu tự động. Kiểm thử WAREHOUSE/SALE/CUSTOMER và concurrent packing nằm trong BE/tests/check_fulfillment.py."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "admin_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "fulfillment_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "package_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "shirt_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "shoe_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cn_warehouse_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vn_warehouse_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_code",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Đăng nhập ADMIN",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"fulfillment_token\",pm.response.json().access_token);",
              "pm.collectionVariables.set(\"run_code\",Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Tạo khách hàng thử",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/customers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{fulfillment_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Khách test vận chuyển\",\n  \"phone\": \"0912345678\",\n  \"address\": \"Hà Nội\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"customer_id\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Tạo đơn thử",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{fulfillment_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"recipient_name\": \"Nguyễn Văn A\",\n  \"recipient_phone\": \"0987654321\",\n  \"recipient_address\": \"Đà Nẵng\",\n  \"items\": [\n    {\n      \"name\": \"Áo thun\",\n      \"quantity\": 10\n    },\n    {\n      \"name\": \"Giày\",\n      \"quantity\": 5\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"order_id\",pm.response.json().id);",
              "if (pm.response.code===201) { const d=pm.response.json(); pm.collectionVariables.set(\"shirt_id\",d.items[0].id); pm.collectionVariables.set(\"shoe_id\",d.items[1].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Xác nhận đơn",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/orders/{{order_id}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{fulfillment_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
